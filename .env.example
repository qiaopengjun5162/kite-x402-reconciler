# kite-x402-reconciler environment example
#
# This tool is fully offline and needs NO environment variables to run.
# The variables below are optional conveniences for shell workflows.

# Default input path used by wrapper scripts (the CLI itself takes --input).
# KITE_RECONCILER_INPUT=./ledger.json

# Default output path for `report`.
# KITE_RECONCILER_OUTPUT=./report.json

# Kite network you are reconciling against (informational; the tool validates
# any CAIP-2 network and does not hard-code chain IDs).
# KITE_NETWORK=eip155:2424

# Token decimals for human-readable amount display in downstream scripts
# (the library's format_atomic takes decimals explicitly; the CLI prints atomic units).
# KITE_TOKEN_DECIMALS=6
